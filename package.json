{
  "name": "threads-sync",
  "version": "0.2.0",
  "private": true,
  "description": "Threads desktop: Google authorization, verified transfers, and manual note copies.",
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "npm run typecheck && node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "package": "npm run build && node scripts/package.mjs"
  },
  "engines": { "node": ">=22.12.0" },
  "devDependencies": {
    "@types/node": "22.15.30",
    "esbuild": "0.28.2",
    "obsidian": "1.14.4",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
